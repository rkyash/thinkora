# ─── Server ───────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
RELOAD=true
LOG_LEVEL=INFO
SECRET_KEY=change-this-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── Authentication ─────────────────────────────────────────────
AUTH_ENABLED=false

# ─── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/thinkora
REDIS_URL=redis://localhost:6379/0

# ─── Data Storage ─────────────────────────────────────────────
THINKORA_DATA_DIR=~/.thinkora
STORAGE_BACKEND=local
# AWS_BUCKET_NAME=
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ─── CORS ─────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── Qdrant ───────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
# QDRANT_API_KEY=

# ─── Embedding ────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# ─── Celery ───────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
THINKORA_WORKER_EXTERNAL=false

# ─── File Uploads ─────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=200

# ─── LLM Providers (configure at least one) ──────────────────
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# MISTRAL_API_KEY=
# OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ─── Custom OpenAI-Compatible Proxy (NVIDIA NIM, vLLM, LM Studio, etc.) ──────
# Set these to route "openai/<model>" calls through your own endpoint.
# OPENAI_PROXY_BASE_URL=https://integrate.api.nvidia.com/v1
# OPENAI_PROXY_API_KEY=nvapi-xxxx

#

# ─── Audio TTS ────────────────────────────────────────────────
TTS_PROVIDER=openai
# KOKORO_BASE_URL=http://localhost:8880
ENABLE_DOCS=true
