"""
Standard API response envelopes.
All routers must return ApiResponse[T] or PaginatedResponse[T].
"""

from typing import Any, Generic, TypeVar

from pydantic import BaseModel

T = TypeVar("T")


class ApiResponse(BaseModel, Generic[T]):
    """Standard API response envelope."""

    success: bool = True
    data: T
    message: str | None = None
    request_id: str | None = None


class PaginatedResponse(BaseModel, Generic[T]):
    """Paginated list response envelope."""

    success: bool = True
    data: list[T]
    total: int
    page: int
    limit: int
    has_next: bool


class ApiError(BaseModel):
    """Error response envelope."""

    success: bool = False
    error: str
    code: str
    request_id: str | None = None


def ok(data: Any, message: str | None = None) -> dict[str, Any]:
    """Helper to construct a successful API response dict."""
    response: dict[str, Any] = {"success": True, "data": data}
    if message:
        response["message"] = message
    return response


def paginated(
    data: list[Any],
    total: int,
    page: int,
    limit: int,
) -> dict[str, Any]:
    """Helper to construct a paginated response dict."""
    return {
        "success": True,
        "data": data,
        "total": total,
        "page": page,
        "limit": limit,
        "has_next": (page * limit) < total,
    }
